---
import { NEWSLETTER_ENDPOINT, FIELD_MAP } from '../data/site.js';
const { country = 'es' } = Astro.props;
const mx = country === 'mx';
import { REGIONS } from '../data/en.js';
const R0 = REGIONS[country].quiz;
const Q = [
 ['fondo','How many months of expenses do you have saved and available (emergency fund)?',[['0','None or almost none'],['1','Less than 3 months'],['2','Between 3 and 6 months'],['3','More than 6 months']]],
 ['deuda', R0.debt,[['si','Yes'],['no','No']]],
 ['plazo','When do you think you will need this money?',[['0','In less than 1 year'],['1','In 1 to 3 years'],['2','In 3 to 5 years'],['3','In more than 5 years']]],
 ['ingresos','How stable is your income?',[['0','Unstable or variable'],['1','Fairly stable'],['2','Very stable']]],
 ['perdida','If your investment fell 30% in a few months, what would you do?',[['0','Sell everything to stop losing'],['1','Worry, but wait'],['2','Hold or invest more']]],
 ['objetivo','What is the main goal for this money?',[['0','A cushion for emergencies'],['1', R0.goal],['2','Grow my wealth / retirement']]],
 ['saber','How much do you know about investing?',[['0','Nothing, I’m just starting'],['1', R0.know],['2','I have invested before']]],
];
const L = { ...R0.links, priv:'/en/privacy/', law:R0.law, prot:REGIONS[country].prot, extra:R0.extra };
const cfg = { L, endpoint: NEWSLETTER_ENDPOINT, F: FIELD_MAP, country };
---
<form id="quiz" class="card" novalidate>
<div class="qprog" aria-hidden="true"><span id="qbar"></span></div>
{Q.map(([n,q,opts],i) => <fieldset class="qstep" data-step={i} hidden={i>0}>
  <legend><span class="meta">Question {i+1} of {Q.length}</span><br/><strong>{q}</strong></legend>
  <div class="opts">{opts.map(([v,l]) => <label><input type="radio" name={n} value={v} required/> {l}</label>)}</div>
</fieldset>)}
<p class="qnav"><button type="button" class="btn ghost" id="qback" hidden>← Back</button> <button type="button" class="btn" id="qnext">Next →</button></p>
</form>
<section id="qres" class="card" hidden aria-live="polite">
<span class="eyebrow">Your result</span><h2 id="rtitle" style="margin-top:12px"></h2><div id="rbody"></div>
<p><small><strong>Disclaimer:</strong> general information based on your answers; not financial advice or a personalised recommendation. Read each product’s official documents before signing up.</small></p>
<p><button type="button" class="btn ghost" id="qagain">Retake the quiz</button></p>
<form id="qmail" method="post" action={NEWSLETTER_ENDPOINT} class="qmail">
  <!-- Proveedor de newsletter: cambia NEWSLETTER_ENDPOINT en src/data/site.js. Campos enviados: email, quiz_result (campo/tag), country, consent, tags. -->
  <h3>Get your result + the weekly newsletter (optional)</h3>
  <label for="qemail" class="sr">Email</label>
  <input id="qemail" type="email" name={FIELD_MAP.email} required placeholder="you@email.com" autocomplete="email"/>
  <input type="hidden" name={FIELD_MAP.result} id="qresult"/>
  <input type="hidden" name={FIELD_MAP.country} value={country}/>
  <input type="hidden" name={FIELD_MAP.tags} id="qtags"/>
  <button class="btn">Email me my result</button>
  <label class="chk"><input type="checkbox" name={FIELD_MAP.consent} value="yes" required/> <span>I agree to receive my result and the newsletter by email and to the processing of my data under the <a href={L.priv}>privacy policy</a> ({L.law}). I can unsubscribe at any time.</span></label>
  <p class="qmsg" role="status"></p>
</form>
</section>
<script is:inline define:vars={{ cfg }}>
(()=>{const f=document.getElementById('quiz'),steps=[...f.querySelectorAll('.qstep')],next=document.getElementById('qnext'),back=document.getElementById('qback'),bar=document.getElementById('qbar');let i=0;
const show=()=>{steps.forEach((s,k)=>s.hidden=k!==i);back.hidden=i===0;next.textContent=i===steps.length-1?'See my result':'Next →';bar.style.width=((i)/steps.length*100)+'%';};
next.onclick=()=>{const s=steps[i];if(!s.querySelector('input:checked')){s.classList.add('err');return;}s.classList.remove('err');if(i<steps.length-1){i++;show();steps[i].querySelector('input').focus();}else result();};
back.onclick=()=>{i--;show();};
f.addEventListener('change',e=>{if(e.target.type==='radio'&&i<steps.length-1)setTimeout(()=>next.click(),180);});
const L=cfg.L,a=(h,t)=>'<a href="'+h+'">'+t+'</a>';
function result(){const d=Object.fromEntries(new FormData(f));const n=k=>+d[k];let key,why=[];
 if(d.deuda==='si'){key='ahorrar';why.push('You have expensive debt: paying it off usually "returns" more than almost any investment, risk-free.');}
 if(n('fondo')<2){key='ahorrar';why.push('Your emergency fund is under 3 months of expenses.');}
 if(!key){let s=0;s+=[-2,0,1,2][n('plazo')];s+=[-1,0,1][n('ingresos')];s+=[-2,1,2][n('perdida')];s+=[-2,-1,2][n('objetivo')];s+=[0,0,1][n('saber')];s+=n('fondo')===3?1:0;
  key=s>=5?'invertir':s>=1?'dos':'ahorrar';
  if(n('plazo')<=1)why.push('You need the money soon: markets can fall right when you need it.');
  if(n('plazo')===3)why.push('Your horizon is long (5+ years), giving time to recover from falls.');
  if(n('perdida')===0)why.push('You would sell after a 30% fall: a sign of low risk tolerance.');
  if(n('perdida')===2)why.push('You handle temporary falls well.');
  if(n('ingresos')===0)why.push('With variable income a bigger cushion helps.');
  why.push('You already have a 3+ month emergency fund.');}
 const R={ahorrar:['Save first','Before investing, prioritise '+(d.deuda==='si'?'paying off expensive debt and ':'')+'building a 3–6 month emergency fund in a low-risk product with '+L.prot+' protection. Compare '+a(L.cuentas,'savings accounts')+' and '+a(L.seguro,L.seguroName)+'.'],
  dos:['Both','Keep your emergency fund in '+a(L.cuentas,'protected accounts ('+L.prot+')')+', use '+a(L.seguro,L.seguroName)+' for 1–3 year goals and, if you like, start investing a part gradually in '+a(L.fondos,'index funds')+' for the long term.'],
  invertir:['Invest','With your emergency fund covered and a long horizon, it makes sense to learn about low-cost '+a(L.fondos,'index funds and robo-advisors')+' with regular contributions. '+a(L.cripto,'Crypto')+' is high risk: at most a small part you can afford to lose.']};
 document.getElementById('rtitle').textContent=R[key][0];
 document.getElementById('rbody').innerHTML='<p class="answer">'+R[key][1]+'</p><h3>Why</h3><ul>'+why.map(w=>'<li>'+w+'</li>').join('')+'</ul><p>'+L.extra+'</p><p>New to this? Start with '+a(L.aprende,'the basics')+'.</p>';
 document.getElementById('qresult').value=R[key][0];document.getElementById('qtags').value='quiz-'+key+','+cfg.country;
 f.hidden=true;const r=document.getElementById('qres');r.hidden=false;r.scrollIntoView({behavior:'smooth'});history.replaceState(null,'','#result-'+key);}
document.getElementById('qagain').onclick=()=>{f.reset();i=0;show();f.hidden=false;document.getElementById('qres').hidden=true;};
document.getElementById('qmail').addEventListener('submit',e=>{const m=e.target,msg=m.querySelector('.qmsg');if(!m.checkValidity()){e.preventDefault();m.reportValidity();return;}
 if(cfg.endpoint.startsWith('#')){e.preventDefault();msg.textContent='Thanks! (Prototype: newsletter provider not configured; nothing was sent.)';}});
show();})();
</script>
<style>
#quiz{max-width:760px;padding:32px}#quiz fieldset{border:0;padding:0;margin:0}#quiz legend{font-size:1.15rem;color:var(--ink);margin-bottom:12px}
.opts{display:flex;flex-direction:column;gap:8px}.opts label{display:flex;gap:10px;align-items:center;padding:12px 16px;border:1px solid var(--line);border-radius:14px;cursor:pointer;background:#F7FAF8}
.opts label:has(input:checked){background:var(--mint);border-color:var(--mint-deep)}.qstep.err legend:after{content:" — choose an option";color:var(--coral-ink);font-size:.85rem}
.qprog{height:6px;background:#E3ECE7;border-radius:6px;margin-bottom:20px;overflow:hidden}.qprog span{display:block;height:100%;background:var(--mint-deep);width:0;transition:width .3s}
.qnav{display:flex;gap:10px;justify-content:space-between;margin-top:20px}
#qres{max-width:820px;background:linear-gradient(150deg,#fff,#E6F7EE);padding:32px}
.qmail{margin-top:24px;background:linear-gradient(135deg,#0F5F4A,#123F33);color:#fff;border-radius:22px;padding:24px;display:flex;flex-wrap:wrap;gap:10px}
.qmail h3{flex-basis:100%;color:#fff;margin:0 0 6px}.qmail input[type=email]{flex:1;min-width:200px}.qmail .btn{background:#BFF2D6;color:#0F1A16}
.qmail .chk{flex-basis:100%;font-size:.85rem;color:#DCEDE5;display:flex;gap:8px;align-items:flex-start}.qmail .chk a{color:#BFF2D6}.qmsg{color:#BFF2D6;margin:0}
</style>
