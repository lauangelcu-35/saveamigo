---
import { NEWSLETTER_ENDPOINT, FIELD_MAP } from '../data/site.js';
const { country = 'es' } = Astro.props;
const mx = country === 'mx';
const Q = [
 ['fondo','¿Cuántos meses de gastos tienes ahorrados y disponibles (fondo de emergencia)?',[['0','Nada o casi nada'],['1','Menos de 3 meses'],['2','Entre 3 y 6 meses'],['3','Más de 6 meses']]],
 ['deuda', mx ? '¿Tienes deudas caras (tarjeta de crédito sin liquidar, préstamos personales con CAT alto)?' : '¿Tienes deudas caras (tarjeta revolving, préstamos personales o al consumo con TAE alta)?',[['si','Sí'],['no','No']]],
 ['plazo','¿Cuándo crees que necesitarás este dinero?',[['0','En menos de 1 año'],['1','Entre 1 y 3 años'],['2','Entre 3 y 5 años'],['3','En más de 5 años']]],
 ['ingresos','¿Cómo de estables son tus ingresos?',[['0','Inestables o variables'],['1','Bastante estables'],['2','Muy estables']]],
 ['perdida', mx ? 'Si tu inversión bajara un 30% en unos meses, ¿qué harías?' : 'Si tu inversión bajara un 30% en unos meses, ¿qué harías?',[['0','Vendería todo para no perder más'],['1','Me preocuparía, pero esperaría'],['2','Mantendría o aportaría más']]],
 ['objetivo','¿Cuál es tu objetivo principal con este dinero?',[['0','Tener un colchón para imprevistos'],['1', mx ? 'Un gasto concreto (enganche de casa, coche, viaje)' : 'Un gasto concreto (entrada de piso, coche, viaje)'],['2','Hacer crecer mi patrimonio / jubilación']]],
 ['saber','¿Cuánto sabes de inversión?',[['0','Nada, estoy empezando'],['1', mx ? 'Lo básico (sé qué son CETES o un fondo)' : 'Lo básico (sé qué es un fondo indexado)'],['2','Ya he invertido antes']]],
];
const L = mx ? { cuentas:'/mx/comparar/cuentas/', seguro:'/mx/comparar/cetes/', fondos:'/mx/comparar/inversion/', cripto:'/mx/comparar/cripto/', aprende:'/mx/aprende/', priv:'/mx/privacidad/', law:'LFPDPPP', prot:'IPAB o PROSOFIPO' }
 : { cuentas:'/comparar/cuentas/', seguro:'/comparar/letras/', fondos:'/comparar/fondos/', cripto:'/comparar/cripto/', aprende:'/aprende/', priv:'/privacidad/', law:'RGPD', prot:'FGD' };
const cfg = { L, endpoint: NEWSLETTER_ENDPOINT, F: FIELD_MAP, country };
---
<form id="quiz" class="card" novalidate>
<div class="qprog" aria-hidden="true"><span id="qbar"></span></div>
{Q.map(([n,q,opts],i) => <fieldset class="qstep" data-step={i} hidden={i>0}>
  <legend><span class="meta">Pregunta {i+1} de {Q.length}</span><br/><strong>{q}</strong></legend>
  <div class="opts">{opts.map(([v,l]) => <label><input type="radio" name={n} value={v} required/> {l}</label>)}</div>
</fieldset>)}
<p class="qnav"><button type="button" class="btn ghost" id="qback" hidden>← Atrás</button> <button type="button" class="btn" id="qnext">Siguiente →</button></p>
</form>
<section id="qres" class="card" hidden aria-live="polite">
<span class="eyebrow">Tu resultado</span><h2 id="rtitle" style="margin-top:12px"></h2><div id="rbody"></div>
<p><small><strong>Aviso:</strong> resultado informativo y general basado en tus respuestas; no es asesoramiento financiero ni una recomendación personalizada. Antes de contratar, lee la documentación oficial de cada producto.</small></p>
<p><button type="button" class="btn ghost" id="qagain">Repetir el quiz</button></p>
<form id="qmail" method="post" action={NEWSLETTER_ENDPOINT} class="qmail">
  <!-- Proveedor de newsletter: cambia NEWSLETTER_ENDPOINT en src/data/site.js. Campos enviados: email, quiz_result (campo/tag), country, consent, tags. -->
  <h3>Recibe tu resultado + la newsletter semanal (opcional)</h3>
  <label for="qemail" class="sr">Email</label>
  <input id="qemail" type="email" name={FIELD_MAP.email} required placeholder="tu@email.com" autocomplete="email"/>
  <input type="hidden" name={FIELD_MAP.result} id="qresult"/>
  <input type="hidden" name={FIELD_MAP.country} value={country}/>
  <input type="hidden" name={FIELD_MAP.tags} id="qtags"/>
  <button class="btn">Enviarme el resultado</button>
  <label class="chk"><input type="checkbox" name={FIELD_MAP.consent} value="yes" required/> <span>Acepto recibir mi resultado y la newsletter por email y el tratamiento de mis datos conforme a la <a href={L.priv}>política de privacidad</a> ({L.law}). Puedo darme de baja en cualquier momento.</span></label>
  <p class="qmsg" role="status"></p>
</form>
</section>
<script is:inline define:vars={{ cfg }}>
(()=>{const f=document.getElementById('quiz'),steps=[...f.querySelectorAll('.qstep')],next=document.getElementById('qnext'),back=document.getElementById('qback'),bar=document.getElementById('qbar');let i=0;
const show=()=>{steps.forEach((s,k)=>s.hidden=k!==i);back.hidden=i===0;next.textContent=i===steps.length-1?'Ver mi resultado':'Siguiente →';bar.style.width=((i)/steps.length*100)+'%';};
next.onclick=()=>{const s=steps[i];if(!s.querySelector('input:checked')){s.classList.add('err');return;}s.classList.remove('err');if(i<steps.length-1){i++;show();steps[i].querySelector('input').focus();}else result();};
back.onclick=()=>{i--;show();};
f.addEventListener('change',e=>{if(e.target.type==='radio'&&i<steps.length-1)setTimeout(()=>next.click(),180);});
const L=cfg.L,a=(h,t)=>'<a href="'+h+'">'+t+'</a>';
function result(){const d=Object.fromEntries(new FormData(f));const n=k=>+d[k];let key,why=[];
 if(d.deuda==='si'){key='ahorrar';why.push('Tienes deudas caras: pagarlas suele "rentar" más que casi cualquier inversión, y sin riesgo.');}
 if(n('fondo')<2){key='ahorrar';why.push('Tu fondo de emergencia es menor de 3 meses de gastos.');}
 if(!key){let s=0;s+=[-2,0,1,2][n('plazo')];s+=[-1,0,1][n('ingresos')];s+=[-2,1,2][n('perdida')];s+=[-2,-1,2][n('objetivo')];s+=[0,0,1][n('saber')];s+=n('fondo')===3?1:0;
  key=s>=5?'invertir':s>=1?'dos':'ahorrar';
  if(n('plazo')<=1)why.push('Necesitarás el dinero en poco tiempo: la bolsa puede caer justo cuando lo necesites.');
  if(n('plazo')===3)why.push('Tu horizonte es largo (más de 5 años), lo que da tiempo a recuperarse de caídas.');
  if(n('perdida')===0)why.push('Venderías ante una caída del 30%: es una señal de baja tolerancia al riesgo.');
  if(n('perdida')===2)why.push('Toleras bien las caídas temporales.');
  if(n('ingresos')===0)why.push('Con ingresos variables conviene un colchón mayor.');
  why.push('Ya tienes un fondo de emergencia de 3+ meses.');}
 const R={ahorrar:['Ahorrar primero','Antes de invertir, prioriza '+(d.deuda==='si'?'liquidar las deudas caras y ':'')+'construir un fondo de emergencia de 3–6 meses de gastos en un producto sin riesgo y con '+L.prot+'. Compara '+a(L.cuentas,'cuentas remuneradas')+' y '+a(L.seguro, cfg.country==='mx'?'CETES':'Letras del Tesoro / depósitos')+'.'],
  dos:['Los dos','Mantén tu fondo de emergencia en '+a(L.cuentas,'cuentas con protección ('+L.prot+')')+', usa '+a(L.seguro,cfg.country==='mx'?'CETES':'Letras o depósitos')+' para objetivos a 1–3 años y, si quieres, empieza a invertir poco a poco una parte en '+a(L.fondos,'fondos indexados')+' para el largo plazo.'],
  invertir:['Invertir','Con tu fondo de emergencia cubierto y un horizonte largo, tiene sentido informarse sobre '+a(L.fondos,'fondos indexados y roboadvisors')+' de bajo coste, con aportaciones periódicas. La '+a(L.cripto,'cripto')+' es de riesgo alto: como mucho, una parte pequeña que puedas perder.']};
 document.getElementById('rtitle').textContent=R[key][0];
 document.getElementById('rbody').innerHTML='<p class="answer">'+R[key][1]+'</p><h3>Por qué</h3><ul>'+why.map(w=>'<li>'+w+'</li>').join('')+'</ul><p>¿Nuevo en esto? Empieza por '+a(L.aprende,'lo básico')+'.</p>';
 document.getElementById('qresult').value=R[key][0];document.getElementById('qtags').value='quiz-'+key+','+cfg.country;
 f.hidden=true;const r=document.getElementById('qres');r.hidden=false;r.scrollIntoView({behavior:'smooth'});history.replaceState(null,'','#resultado-'+key);}
document.getElementById('qagain').onclick=()=>{f.reset();i=0;show();f.hidden=false;document.getElementById('qres').hidden=true;};
document.getElementById('qmail').addEventListener('submit',e=>{const m=e.target,msg=m.querySelector('.qmsg');if(!m.checkValidity()){e.preventDefault();m.reportValidity();return;}
 if(cfg.endpoint.startsWith('#')){e.preventDefault();msg.textContent='Gracias. (Prototipo: proveedor de newsletter no configurado; no se ha enviado nada.)';}});
show();})();
</script>
<style>
#quiz{max-width:760px;padding:32px}#quiz fieldset{border:0;padding:0;margin:0}#quiz legend{font-size:1.15rem;color:var(--ink);margin-bottom:12px}
.opts{display:flex;flex-direction:column;gap:8px}.opts label{display:flex;gap:10px;align-items:center;padding:12px 16px;border:1px solid var(--line);border-radius:14px;cursor:pointer;background:#F7FAF8}
.opts label:has(input:checked){background:var(--mint);border-color:var(--mint-deep)}.qstep.err legend:after{content:" — elige una opción";color:var(--coral-ink);font-size:.85rem}
.qprog{height:6px;background:#E3ECE7;border-radius:6px;margin-bottom:20px;overflow:hidden}.qprog span{display:block;height:100%;background:var(--mint-deep);width:0;transition:width .3s}
.qnav{display:flex;gap:10px;justify-content:space-between;margin-top:20px}
#qres{max-width:820px;background:linear-gradient(150deg,#fff,#E6F7EE);padding:32px}
.qmail{margin-top:24px;background:linear-gradient(135deg,#0F5F4A,#123F33);color:#fff;border-radius:22px;padding:24px;display:flex;flex-wrap:wrap;gap:10px}
.qmail h3{flex-basis:100%;color:#fff;margin:0 0 6px}.qmail input[type=email]{flex:1;min-width:200px}.qmail .btn{background:#BFF2D6;color:#0F1A16}
.qmail .chk{flex-basis:100%;font-size:.85rem;color:#DCEDE5;display:flex;gap:8px;align-items:flex-start}.qmail .chk a{color:#BFF2D6}.qmsg{color:#BFF2D6;margin:0}
</style>
